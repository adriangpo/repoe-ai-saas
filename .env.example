# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e nunca deve ir para o repositório.

# Banco de dados (usado pelo docker-compose e pela API)
DB_NAME=repoeai
DB_USER=repoeai
DB_PASSWORD=troque-esta-senha
DB_PORT=5433
DB_HOST=localhost

# Se preferir, informe a conexão completa (ex.: Postgres já instalado na máquina).
# Quando definida, substitui as variáveis DB_* acima.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/repoeai

# Porta da API
PORT=3333

# Segredo usado para assinar os tokens de login. Gere um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Chave do JEV. Opcional: sem chave, o assistente de reposição usa as regras locais.
# Use a chave da OpenRouter (começa com sk-or-) OU a chave direta da TypeSafe;
# o endpoint é escolhido automaticamente conforme a chave.
OPENROUTER_API_KEY=
# JEV_API_KEY=
# JEV_URL=https://openrouter.ai/api/v1/systemone
